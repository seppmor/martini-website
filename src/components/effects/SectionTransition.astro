<div class="section-transition-overlay" aria-hidden="true">
  <p class="section-transition-title"></p>
</div>

<script>
  const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-section-nav]"));
  const overlay = document.querySelector<HTMLElement>(".section-transition-overlay");
  const title = overlay?.querySelector<HTMLElement>(".section-transition-title");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const mobileViewport = window.matchMedia("(max-width: 820px)");
  const root = document.documentElement;
  const labels = new Map(
    Array.from(document.querySelectorAll<HTMLAnchorElement>(".timeline-link")).map((link) => [
      link.hash.slice(1),
      link.querySelector<HTMLElement>(".timeline-label")?.textContent?.trim() ?? "",
    ]),
  );

  let transitioningSection: HTMLElement | undefined;
  let overlayAnimation: Animation | undefined;
  let titleAnimation: Animation | undefined;
  let revealTimer = 0;
  let mobileScrollTimer = 0;
  let mobileLockedScrollPosition: number | undefined;
  let mobileSectionIndex = 0;

  const revealSection = (section: HTMLElement | undefined) => section?.classList.add("is-revealed");
  const revealOnlySection = (section: HTMLElement | undefined) => {
    if (!section) return;
    sections.forEach((currentSection) => {
      currentSection.classList.toggle("is-revealed", currentSection === section);
    });
  };

  const scrollPaddingTop = () => Number.parseFloat(getComputedStyle(root).scrollPaddingTop) || 0;
  const sectionSnapPosition = (section: HTMLElement) => {
    const top = section.getBoundingClientRect().top + window.scrollY - scrollPaddingTop();
    const maximum = Math.max(0, root.scrollHeight - window.innerHeight);
    return Math.min(Math.max(0, top), maximum);
  };
  const snapToSection = (section: HTMLElement) => {
    window.scrollTo({ top: sectionSnapPosition(section), behavior: "auto" });
  };

  const sectionAtAnchorIndex = () => {
    const anchor = window.innerHeight * 0.22;
    const containingIndex = sections.findIndex((section) => {
      const bounds = section.getBoundingClientRect();
      return bounds.top <= anchor && bounds.bottom > anchor;
    });
    if (containingIndex >= 0) return containingIndex;

    return sections.reduce((closestIndex, section, index) => {
      const bounds = section.getBoundingClientRect();
      const distance = bounds.bottom < anchor ? anchor - bounds.bottom : bounds.top - anchor;
      const closestBounds = sections[closestIndex].getBoundingClientRect();
      const closestDistance = closestBounds.bottom < anchor
        ? anchor - closestBounds.bottom
        : closestBounds.top - anchor;
      return distance < closestDistance ? index : closestIndex;
    }, 0);
  };

  const lockMobileScroll = () => {
    if (!mobileViewport.matches || root.classList.contains("is-section-scroll-locked")) return;

    mobileLockedScrollPosition = window.scrollY;
    root.style.setProperty("--section-scroll-lock-offset", `${-mobileLockedScrollPosition}px`);
    root.classList.add("is-section-scroll-locked");
  };

  const unlockMobileScroll = () => {
    if (mobileLockedScrollPosition === undefined) return;

    const restorePosition = mobileLockedScrollPosition;
    mobileLockedScrollPosition = undefined;
    root.classList.remove("is-section-scroll-locked");
    root.style.removeProperty("--section-scroll-lock-offset");
    window.scrollTo({ top: restorePosition, behavior: "auto" });
  };

  const finishCurrentTransition = () => {
    window.clearTimeout(revealTimer);
    revealOnlySection(transitioningSection);
    transitioningSection = undefined;
    overlayAnimation?.cancel();
    titleAnimation?.cancel();
    overlayAnimation = undefined;
    titleAnimation = undefined;
    overlay?.classList.remove("is-active");
    unlockMobileScroll();
  };

  const playTransition = (section: HTMLElement) => {
    if (!overlay || !title) {
      revealSection(section);
      return;
    }

    finishCurrentTransition();
    lockMobileScroll();
    transitioningSection = section;
    section.classList.remove("is-revealed");
    title.textContent = labels.get(section.id) || section.id;
    overlay.classList.add("is-active");

    overlayAnimation = overlay.animate(
      [
        { opacity: 0, backdropFilter: "blur(0px)", backgroundColor: "rgba(247, 237, 221, 0)" },
        { opacity: 1, backdropFilter: "blur(11px)", backgroundColor: "rgba(247, 237, 221, 0.22)", offset: 0.0526 },
        { opacity: 1, backdropFilter: "blur(11px)", backgroundColor: "rgba(247, 237, 221, 0.22)", offset: 0.9474 },
        { opacity: 0, backdropFilter: "blur(0px)", backgroundColor: "rgba(247, 237, 221, 0)" },
      ],
      { duration: 950, easing: "linear", fill: "both" },
    );

    titleAnimation = title.animate(
      [
        { opacity: 0, filter: "blur(14px)", transform: "translateY(14px) scale(0.94)" },
        { opacity: 0, filter: "blur(12px)", transform: "translateY(10px) scale(0.96)", offset: 0.12 },
        { opacity: 1, filter: "blur(0px)", transform: "translateY(0) scale(1)", offset: 0.22 },
        { opacity: 1, filter: "blur(0px)", transform: "translateY(0) scale(1)", offset: 0.9474 },
        { opacity: 0, filter: "blur(14px)", transform: "translateY(-12px) scale(1.04)" },
      ],
      { duration: 950, easing: "linear", fill: "both" },
    );

    revealTimer = window.setTimeout(() => {
      if (transitioningSection === section) revealSection(section);
    }, 850);

    overlayAnimation.addEventListener("finish", () => {
      if (transitioningSection !== section) return;
      window.clearTimeout(revealTimer);
      revealOnlySection(section);
      transitioningSection = undefined;
      overlay.classList.remove("is-active");
      overlayAnimation?.cancel();
      titleAnimation?.cancel();
      overlayAnimation = undefined;
      titleAnimation = undefined;
      unlockMobileScroll();
    });
  };

  const handleTransitionStart = (event: Event) => {
    const sectionId = (event as CustomEvent<{ sectionId?: string }>).detail?.sectionId;
    const section = sections.find((candidate) => candidate.id === sectionId);
    if (!section || section === transitioningSection) return;

    if (reduceMotion.matches) {
      revealOnlySection(section);
      return;
    }
    playTransition(section);
  };

  window.addEventListener("martini:section-transition-start", handleTransitionStart);

  const runMobileTransition = () => {
    window.clearTimeout(mobileScrollTimer);
    mobileScrollTimer = 0;
    if (!mobileViewport.matches || transitioningSection || root.classList.contains("is-section-scroll-locked")) return;

    const detectedIndex = sectionAtAnchorIndex();
    if (detectedIndex === mobileSectionIndex) return;

    // Even if a strong Safari flick crosses several snap points, advance only
    // one chapter. This keeps navigation, hash and title transition in sync.
    const direction = Math.sign(detectedIndex - mobileSectionIndex);
    const targetIndex = Math.min(
      sections.length - 1,
      Math.max(0, mobileSectionIndex + direction),
    );
    const target = sections[targetIndex];
    if (!target) return;

    mobileSectionIndex = targetIndex;
    snapToSection(target);
    window.history.replaceState(null, "", `#${target.id}`);

    if (reduceMotion.matches) revealOnlySection(target);
    else playTransition(target);
  };

  const scheduleMobileTransition = () => {
    if (!mobileViewport.matches || transitioningSection || root.classList.contains("is-section-scroll-locked")) return;
    window.clearTimeout(mobileScrollTimer);
    mobileScrollTimer = window.setTimeout(runMobileTransition, 140);
  };

  const handleMobileSectionChangeRequest = (event: Event) => {
    if (!mobileViewport.matches) return;

    const sectionId = (event as CustomEvent<{ sectionId?: string }>).detail?.sectionId;
    const targetIndex = sections.findIndex((section) => section.id === sectionId);
    const target = sections[targetIndex];
    if (!target) return;

    window.clearTimeout(mobileScrollTimer);
    mobileSectionIndex = targetIndex;
    snapToSection(target);
    window.history.replaceState(null, "", `#${target.id}`);

    if (reduceMotion.matches) revealOnlySection(target);
    else playTransition(target);
  };

  window.addEventListener("martini:section-change-request", handleMobileSectionChangeRequest);

  if (reduceMotion.matches) {
    sections.forEach(revealSection);
  } else if (mobileViewport.matches) {
    const hashIndex = sections.findIndex((section) => `#${section.id}` === window.location.hash);
    mobileSectionIndex = hashIndex >= 0 ? hashIndex : sectionAtAnchorIndex();
    revealOnlySection(sections[mobileSectionIndex]);
    window.addEventListener("scroll", scheduleMobileTransition, { passive: true });
    window.addEventListener("scrollend", runMobileTransition, { passive: true });
  } else if ("IntersectionObserver" in window) {
    // Desktop keeps the explicit wheel gate. This observer only prevents a
    // blank section if a browser moves the viewport without that gate.
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) revealSection(entry.target as HTMLElement);
        });
      },
      { rootMargin: "12% 0px", threshold: 0.01 },
    );

    sections.forEach((section) => revealObserver.observe(section));
  }
</script>
