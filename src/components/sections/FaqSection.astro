---
import type { CollectionEntry } from "astro:content";
import SectionHeading from "../ui/SectionHeading.astro";

interface Props {
  content: CollectionEntry<"faq">["data"];
}

const { content } = Astro.props;
---

<section class="section-shell snap-section" id="faq" data-section-nav>
  <div class="section-silhouette" aria-hidden="true"></div>
  <SectionHeading kicker={content.kicker} title={content.title} intro={content.intro} />
  <div class="faq-list">
    {
      content.items.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>
